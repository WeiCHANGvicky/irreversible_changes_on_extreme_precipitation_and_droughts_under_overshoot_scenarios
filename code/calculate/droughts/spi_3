
import glob
import os
import warnings
import numpy as np
from scipy.stats import gamma, norm
import xarray as xr

warnings.filterwarnings('ignore')


  ssp_dir = r'E:\data\pr\ssp534'
hist_dir = r'E:\data\pr\historical'
gamma_dir = r'E:\data\gamma\SPI1_gamma.nc'  # 存放上一步算好的 Gamma 参数文件的目录
out_dir = r'F:\spi\ssp534\spi_1'  


os.makedirs(out_dir, exist_ok=True)

folders = sorted(glob.glob(os.path.join(ssp_dir, '*')))

for folder in folders:
  folder_name = os.path.basename(folder)[:-1]
  print(f'正在处理模式: {folder_name}')

  
  gamma_file = gamma_dir
  
  gamma_ds = xr.open_dataset(gamma_file).load()
  shape = gamma_ds['shape']
  scale = gamma_ds['scale']
  loc = gamma_ds['loc'] if 'loc' in gamma_ds else 0
  p_zero = gamma_ds['p_zero'] if 'p_zero' in gamma_ds else 0  
  
  
  folder_name =f'{folder_name}1'
  hist_folder = os.path.join(hist_dir, folder_name)
  hist_files = sorted(glob.glob(os.path.join(hist_folder, '*.nc')))
  ssp_files = sorted(glob.glob(os.path.join(folder, '*.nc')))

  if not hist_files or not ssp_files:
    print(f'⚠️ 历史或 SSP 文件缺失，跳过该模式: {folder_name}')
    continue

  pr_hist = xr.open_mfdataset(hist_files, use_cftime=True, compat='override', coords='minimal')['pr']
  pr_ssp = xr.open_mfdataset(ssp_files, use_cftime=True, compat='override', coords='minimal')['pr']

  
  pr = xr.concat([pr_hist, pr_ssp], dim='time').load()
  
  
  pr_3 = pr.rolling(time=1, min_periods=1).sum()
 
  
  spi_months = []

  for month in range(1, 13):
    
    pr_3_m = pr_3.where(pr_3.time.dt.month == month, drop=True)

    
    sh = shape.sel(month=month).values
    sc = scale.sel(month=month).values
    lc = loc.sel(month=month).values if isinstance(loc, xr.DataArray) else loc
    q = (
        p_zero.sel(month=month).values
        if isinstance(p_zero, xr.DataArray)
        else 0
    )
    vals = pr_3_m.values
    vals_pos = np.where(vals > 0, vals, 0.0)
    g_x = gamma.cdf(
        vals_pos,
        a=sh[None, ...],
        loc=lc[None, ...] if isinstance(lc, np.ndarray) else lc,
        scale=sc[None, ...],
    )
    h_x = q[None, ...] + (1.0 - q[None, ...]) * g_x
    h_x = np.clip(h_x, 1e-6, 1.0 - 1e-6)
    spi_m_vals = norm.ppf(h_x)
    spi_m = xr.DataArray(
        spi_m_vals, coords=pr_3_m.coords, dims=pr_3_m.dims, name='spi_3'
    )
    spi_months.append(spi_m)

  
  spi_3 = (
      xr.concat(spi_months, dim='time').sortby('time').transpose('time', ...)
  )

  
  out_file = os.path.join(out_dir, f'{folder_name}_SPI1.nc')
  spi_3.to_netcdf(out_file)

  
  gamma_ds.close()
  del pr, pr_3, spi_3
