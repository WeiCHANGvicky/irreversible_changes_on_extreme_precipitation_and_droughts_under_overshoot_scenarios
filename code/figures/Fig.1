area = xr.open_dataset(area_file)['areacella']


def weighted(data, weights):
  num = (data * weights).sum(dim=('lat', 'lon'))
  den = weights.sum(dim=('lat', 'lon'))
  return num / den


def process_gmst(file_pattern):
  files = sorted(glob.glob(file_pattern))
  gmst_list = []
  for file in files:
    ds = xr.open_dataset(file)
    tas = ds['tas'] - 273.15
    temp = weighted(tas, area)
    gmst = temp - temp.sel(time=slice('1850', '1900')).mean('time')
    gmst_list.append(gmst)

  le_gmst = xr.concat(gmst_list, dim='member')
  lem_gmst = le_gmst.mean('member')
  smoothed_gmst = lem_gmst.rolling(time=21, center=True).mean('time')
  return le_gmst, smoothed_gmst



